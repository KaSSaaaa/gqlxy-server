{
  "name": "gqlxy-server",
  "version": "0.1.0",
  "description": "C++ GraphQL server engine that let's you develop your server how you want it",
  "homepage": "https://github.com/KaSSaaaa/gqlxy",
  "license": "MIT",
  "supports": "!uwp",
  "configuration": {
    "default-registry": {
      "kind": "builtin",
      "baseline": "e5a1490e1409d175932ef6014519e9ae149ddb7c"
    },
    "registries": [
      {
        "kind": "git",
        "repository": "https://github.com/KaSSaaaa/vcpkg.git",
        "reference": "feature/gqlxy",
        "baseline": "3da047996f953e0577028e2818a02b6958f71a8c",
        "packages": [
          "gqlxy-*"
        ]
      }
    ]
  },
  "dependencies": [
    "gqlxy-core",
    "cppgraphqlgen",
    "nlohmann-json",
    "pegtl",
    "better-enums"
  ],
  "features": {
    "tests": {
      "description": "Build and run the test suite",
      "dependencies": [
        "gtest",
        "boost-beast",
        "gqlxy-client"
      ]
    },
    "standalone-server": {
      "description": "Standalone HTTP/WebSocket/SSE GraphQL server using oatpp",
      "dependencies": [
        {
          "name": "oatpp",
          "version>=": "1.3.1"
        },
        "oatpp-websocket",
        "oatpp-openssl"
      ]
    }
  }
}
